# Copy these into Vercel → Project → Settings → Environment Variables, then redeploy.
# Never put real values in HTML/JS files or commit them to Git.

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Recipient in international digits, no plus sign (e.g. 60123456789)
WHATSAPP_RECIPIENT_PHONE=
# Name of your approved utility template (one body variable {{1}})
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en
# Optional (defaults to v23.0)
WHATSAPP_API_VERSION=v23.0
